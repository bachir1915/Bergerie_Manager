pipeline {
    agent any
    
    tools {
        maven 'maven3'  
        jdk 'jdk17'
    }
    
    stages {  
        stage('Checkout') {
            steps {
                git branch: 'main', credentialsId: 'githup-cred', url: 'https://github.com/bachir1915/NombrePremier.git'
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn clean compile'
            }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
    }

    post {
        always {
            cleanWs()
        }       
    }
}
