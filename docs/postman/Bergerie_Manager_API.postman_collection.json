                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });",
                  "var l = pm.response.json(); var a = l.filter(function (x) { return x.statutAlerte !== 'TRAITEE'; })[0] || l[0];",
                  "pm.test('Une alerte existe', function () { if (!a) throw new Error('aucune alerte'); });",
